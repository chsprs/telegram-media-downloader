# Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram API ID & Hash from my.telegram.org (dibutuhkan untuk engine MTProto limit 2 GB)
API_ID=33432678
API_HASH=e272c0676a332ac9be9d721c875d870a

# Optional: ID Telegram pengguna yang diizinkan (pisahkan koma jika lebih dari satu)
# Jika dikosongkan, bot dapat digunakan oleh siapa saja
ALLOWED_USER_IDS=

# Direktori penyimpanan unduhan di eMMC disk (jangan taruh di /tmp karena tmpfs RAM cuma 895MB)
DOWNLOAD_DIR=/opt/telegram-media-downloader/downloads

# Unduhan paralel maksimum (STB ARM lemah: 2 sudah cukup)
MAX_CONCURRENT_DOWNLOADS=2

# Sisa disk minimum (MB) sebelum unduhan ditolak / dihentikan
MIN_FREE_DISK_MB=512

# Buang file sisa > umur ini (detik), dicek tiap PRUNE_INTERVAL_SECONDS
PRUNE_MAX_AGE_SECONDS=3600
PRUNE_INTERVAL_SECONDS=1800

# Batas ukuran file yang diunggah balik ke Telegram (MB). Engine MTProto mendukung s.d 2000 MB.
MAX_UPLOAD_MB=1000
