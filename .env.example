# Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Optional: ID Telegram pengguna yang diizinkan (pisahkan koma jika lebih dari satu)
# Jika dikosongkan, bot dapat digunakan oleh siapa saja
ALLOWED_USER_IDS=

# Direktori sementara penyimpanan file sebelum diunggah
DOWNLOAD_DIR=/tmp/tg_media_downloader
