#!/bin/sh
# tdl — kontrol Telegram Media Downloader Bot
# Pakai: tdl on | off | restart | status | log | update | token | help

SVC="telegram-downloader.service"
DIR="/opt/telegram-media-downloader"
ENVF="$DIR/.env"

case "$1" in
    on|start)      ACTION="Nyalakan bot" ;;
    off|stop)      ACTION="Matikan bot" ;;
    restart|rs)    ACTION="Restart bot" ;;
    status|st)     ACTION="Status bot" ;;
    log|logs|l)    ACTION="Lihat log" ;;
    update|up)     ACTION="Update bot" ;;
    token)         ACTION="Edit token" ;;
    help|-h|--help|"")
        cat <<EOF
Penggunaan: tdl <perintah>

  tdl on        nyalakan bot
  tdl off       matikan bot
  tdl restart   restart bot
  tdl status    cek status
  tdl log       lihat log realtime (Ctrl+C keluar)
  tdl update    update bot + yt-dlp
  tdl token     edit token / whitelist

Alias: start|stop|rs|st|l|up
EOF
        exit 0 ;;
    *) echo "Perintah tidak dikenal: $1"; echo "Coba: tdl help"; exit 1 ;;
esac

# butuh root -> ulangi pakai sudo
if [ "$(id -u)" -ne 0 ]; then
    exec sudo -- "$0" "$@"
fi

case "$1" in
    on|start)
        systemctl start "$SVC"
        sleep 1
        if systemctl is-active --quiet "$SVC"; then
            echo "Bot NYALA ✅"
        else
            echo "Bot GAGAL nyala ❌ — cek: tdl log"
            exit 1
        fi ;;
    off|stop)
        systemctl stop "$SVC"
        echo "Bot MATI ⏹" ;;
    restart|rs)
        systemctl restart "$SVC"
        sleep 1
        systemctl is-active --quiet "$SVC" && echo "Bot RESTART OK 🔄" || { echo "Gagal restart ❌"; exit 1; } ;;
    status|st)
        if systemctl is-active --quiet "$SVC"; then echo "Status: NYALA ✅"; else echo "Status: MATI ⏹"; fi
        echo "Autostart saat boot: $(systemctl is-enabled "$SVC" 2>/dev/null || echo disabled)" ;;
    log|logs|l)
        journalctl -u "$SVC" -n 50 -f ;;
    update|up)
        cd "$DIR" || exit 1
        git pull
        ./venv/bin/pip install -q -r requirements.txt
        ./venv/bin/pip install -q -U yt-dlp
        systemctl restart "$SVC"
        echo "Update selesai, bot di-restart 🔄" ;;
    token)
        "${EDITOR:-nano}" "$ENVF"
        systemctl restart "$SVC"
        echo "Config disimpan, bot di-restart 🔄" ;;
esac
